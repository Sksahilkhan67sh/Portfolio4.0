# --- App ---
APP_ENV=development
APP_NAME=AlignCraft Portfolio API
FRONTEND_ORIGIN=http://localhost:5173

# --- Database ---
# Dev (SQLite):
DATABASE_URL=sqlite:///./database/app.db
# Prod (Postgres), example:
# DATABASE_URL=postgresql+psycopg2://user:password@db:5432/portfolio

# --- Auth / JWT ---
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Admin login ---
ADMIN_USERNAME=sahil
# Generate with: python -c "from passlib.hash import bcrypt; print(bcrypt.hash('your-password'))"
ADMIN_PASSWORD_HASH=

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Sahil Khan Portfolio
ADMIN_NOTIFY_EMAIL=sahilkhan67sh@gmail.com
EMAIL_ENABLED=true

# --- Rate limiting ---
CONTACT_RATE_LIMIT=5/10minutes
